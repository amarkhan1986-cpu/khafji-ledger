{
 "id": "./",
 "name": "Khafji Ledger",
 "short_name": "Ledger",
 "description": "Household money for Al-Khafji. Scan bills, PDFs and bank messages without internet.",
 "start_url": "./?source=app",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#F4F6F3",
 "theme_color": "#F4F6F3",
 "categories": [
  "finance",
  "productivity"
 ],
 "icons": [
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icons/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "files",
     "accept": [
      "image/*",
      "application/pdf",
      ".pdf",
      ".heic",
      ".heif",
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      "text/csv",
      ".csv"
     ]
    }
   ]
  }
 },
 "shortcuts": [
  {
   "name": "Scan a bill",
   "url": "./?action=camera",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ]
  }
 ]
}